# --- CLion / JetBrains IDE ---
# Пользовательские настройки (workspace, задачи, статистика)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Специфичные для CLion файлы проекта
.idea/*.iml
*.iml

# Опционально: если не хотите делиться папкой .idea целиком,
# можно раскомментировать строку ниже, но обычно стили кода
# и конфигурации запуска полезно хранить в репозитории.
# .idea/

# --- CMake / Сборка ---
# Папки сборки, создаваемые CLion (Debug, Release и т.д.)
cmake-build-*/
build/
out/

# --- C/C++ артефакты ---
# Объектные файлы
*.o
*.obj
*.lo
*.slo

# Статические и динамические библиотеки
*.a
*.lib
*.so
*.dylib
*.dll
*.la
*.lai

# Исполняемые файлы
*.exe
*.out
*.app

# Прекомпилированные заголовки
*.gch
*.pch

# Файлы зависимостей (генерируются компилятором)
*.d